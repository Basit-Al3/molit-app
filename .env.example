# ---- Database (any Postgres: Supabase, Neon, RDS, local) ----
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://user:password@host:5432/molit

# ---- App ----
APP_URL=http://localhost:3000
# 32+ random chars. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Protects /api/cron/monthly. Generate: openssl rand -hex 32
CRON_SECRET=change-me-too

# ---- WhatsApp Cloud API (Meta) ----
# The number people text, digits only, with country code. Used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
# From Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Any string you choose; paste the same value into the webhook config on Meta.
WHATSAPP_VERIFY_TOKEN=molit-verify
# App → Settings → Basic → App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Name of your approved monthly-summary template (see README). Optional.
WHATSAPP_SUMMARY_TEMPLATE=molit_monthly_summary

# ---- Optional: Claude fallback for messages like "paid two hundred for lunch" ----
ANTHROPIC_API_KEY=
